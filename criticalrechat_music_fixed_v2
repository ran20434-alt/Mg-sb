-- Render Message Item
function renderMessageItem(data, msgId)
    if renderedMessageIds[msgId] then return end
    renderedMessageIds[msgId] = true

    local isSystem = (data.Sender == "SYSTEM" or data.isSys)
    local isSticker = string.find(data.Text or data.message or "", "%[STICKER%]:")
    local isImage = string.find(data.Text or data.message or "", "%[IMAGE%]:") or data.isImg

    if isSystem then
        addSys(data.Text or data.message or "")
    elseif isSticker then
        local assetId = string.gsub(data.Text or data.message or "", "%[STICKER%]:%s*", "")
        addMsg(data.Sender or data.sender, data.DisplayName or data.displayName or data.Sender or data.sender, "", MsgScroll, true, assetId, data.UserId or data.userId, msgId)
    elseif isImage then
        local imgUrl = data.imgUrl or string.gsub(data.Text or data.message or "", "%[IMAGE%]:%s*", "")
        addMsg(data.Sender or data.sender, data.DisplayName or data.displayName or data.Sender or data.sender, "", MsgScroll, true, imgUrl, data.UserId or data.userId, msgId)
    else
        local textVal = data.Text or data.message or ""
        addMsg(data.Sender or data.sender, data.DisplayName or data.displayName or data.Sender or data.sender, textVal, MsgScroll, false, nil, data.UserId or data.userId, msgId, data.replyData, data.isPrivate)
    end

    if not isInitialLoad and (data.Sender or data.sender) ~= PlayerName then
        local senderLabel = data.DisplayName or data.displayName or data.Sender or data.sender
        sendBigWhiteNotification("📩 New message from " .. senderLabel)
        if messageMentionsLocalPlayer(data.Text or data.message or "") then
            sendBigWhiteNotification("🔔 You were tagged by @" .. senderLabel)
        end
    end
end

-- ARIA BOT SYSTEM
-- ARIA uses the existing Director/Creator access layer.
local ARIA_DISPLAY_NAME = "rndyrona"
local ARIA_STICKER_COUNT = #PRESET_ASSETS

local function ariaReply(text)
    addSys("🤖 ARIA [" .. ARIA_DISPLAY_NAME .. "]\n" .. tostring(text), Color3.fromRGB(55, 25, 85))
end

local function sendAriaAnnouncement(text)
    local message = "📢 [ARIA ANNOUNCEMENT] " .. tostring(text)
    sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {
        Sender = "ARIA",
        DisplayName = ARIA_DISPLAY_NAME,
        Text = message,
        timestamp = os.time(),
        isSys = true,
        aria = true
    })
    addSys("✅ ARIA announcement sent as @" .. ARIA_DISPLAY_NAME)
end

local function ariaHelp()
    return "Commands: /help aria, /aria status, /aria stickers, /aria announce <message>.\n" ..
        "Admin commands: /aria title <user> <tag>, /aria untitle <user>, /aria vip <user>, /aria unvip <user>,\n" ..
        "/aria setrank <user> <tag>, /aria removerank <user>, /aria play <assetId>, /aria volume <0-10>,\n" ..
        "/aria stopmusic, /aria ban <user> <reason>, /aria unban <user>."
end

local function handleAriaCommand(txt, lowerTxt)
	if lowerTxt == "/help aria" or lowerTxt == "aria help" then
		addSys("📋 System Help: ARIA commands are available below.")
		ariaReply(ariaHelp())
		return true
	end

	local command = txt:match("^/?[Aa][Rr][Ii][Aa]%s+(.+)$")
	if not command then return false end
    local commandLower = command:lower()

    if commandLower == "help" then
        ariaReply(ariaHelp())
        return true
    elseif commandLower == "status" then
        ariaReply("Online. Director access: " .. (hasAdminAccess(PlayerName) and "enabled" or "standard") ..
            ". Stickers loaded: " .. tostring(ARIA_STICKER_COUNT) .. ". Music system: online.")
        return true
    elseif commandLower == "stickers" or commandLower == "sticker list" then
        ariaReply("The sticker system is online with " .. tostring(ARIA_STICKER_COUNT) .. " preset stickers. Open the sticker panel to browse and send them.")
        return true
    end

    if not hasAriaAdminAccess(PlayerName) then
        ariaReply("Access denied. ARIA admin commands are restricted to Directors, Creators, and approved ARIA administrators.")
        return true
    end

    local announce = command:match("^[Aa][Nn][Nn][Oo][Uu][Nn][Cc][Ee]%s+(.+)$")
    if announce then
        sendAriaAnnouncement(announce)
        return true
    end

    local target, value = command:match("^[Tt][Ii][Tt][Ll][Ee]%s+(%S+)%s+(.+)$")
    if target and value then
        if not isDirectorUser(PlayerName) then ariaReply("Only Directors can give ARIA tags."); return true end
        putFirebaseData("dynamic_ranks/" .. target:lower(), {title = "[" .. value:upper() .. "]", type = "rgb", removed = false})
        syncRanks()
        sendAriaAnnouncement("🏷️ ARIA assigned [" .. value:upper() .. "] to @" .. target)
        ariaReply("Tag assigned to @" .. target .. ".")
        return true
    end

    target = command:match("^[Uu][Nn][Tt][Ii][Tt][Ll][Ee]%s+(%S+)$")
    if target then
        if not isDirectorUser(PlayerName) then ariaReply("Only Directors can remove ARIA tags."); return true end
        putFirebaseData("dynamic_ranks/" .. target:lower(), {title = "NONE", removed = true})
        syncRanks()
        sendAriaAnnouncement("🗑️ ARIA removed the tag from @" .. target)
        ariaReply("Tag removed from @" .. target .. ".")
        return true
    end

    target = command:match("^[Vv][Ii][Pp]%s+(%S+)$")
    if target then
        putFirebaseData("dynamic_ranks/" .. target:lower(), {title = "[VIP]", type = "rgb", removed = false})
        syncRanks()
        sendAriaAnnouncement("⭐ ARIA granted VIP to @" .. target)
        ariaReply("VIP granted to @" .. target .. ".")
        return true
    end

    target = command:match("^[Uu][Nn][Vv][Ii][Pp]%s+(%S+)$")
    if target then
        putFirebaseData("dynamic_ranks/" .. target:lower(), {title = "NONE", removed = true})
        syncRanks()
        sendAriaAnnouncement("🗑️ ARIA removed VIP/tag access from @" .. target)
        ariaReply("VIP/tag access removed from @" .. target .. ".")
        return true
    end

    local assetId = command:match("^[Pp][Ll][Aa][Yy]%s+(%d+)$") or command:match("^[Mm][Uu][Ss][Ii][Cc]%s+(%d+)$")
    if assetId then
        putFirebaseData("servers/" .. SERVER_KEY .. "/global_music", {audioId = assetId, playedBy = ARIA_DISPLAY_NAME, timestamp = os.time()})
        if assetId == "0" then globalSound:Stop(); ariaReply("Music stopped.") else globalSound.SoundId = "rbxassetid://" .. assetId; globalSound:Play(); ariaReply("Playing audio ID " .. assetId .. ".") end
        return true
    end

    local volume = command:match("^[Vv][Oo][Ll][Uu][Mm][Ee]%s+(%d+)$")
    if volume then
        local n = math.clamp(tonumber(volume), 0, 10)
        currentGlobalVolume = n
        soundGroup.Volume = n
        globalSound.Volume = n
        putFirebaseData("servers/" .. SERVER_KEY .. "/global_volume", {volume = n, setBy = ARIA_DISPLAY_NAME})
        ariaReply("Volume set to " .. tostring(n) .. ".")
        return true
    end

    if commandLower == "stopmusic" then
        globalSound:Stop()
        ariaReply("Music stopped.")
        return true
    end

    local banUser, reason = command:match("^[Bb][Aa][Nn]%s+(%S+)%s*(.*)$")
    if banUser then
        if isDirectorUser(banUser) then ariaReply("Directors are immune to bans."); return true end
        putFirebaseData("bans/" .. banUser:lower(), {banned = true, reason = reason ~= "" and reason or "Banned by ARIA", by = ARIA_DISPLAY_NAME, timestamp = os.time()})
        sendAriaAnnouncement("🔨 ARIA banned @" .. banUser)
        ariaReply("@" .. banUser .. " has been banned.")
        return true
    end

    target = command:match("^[Uu][Nn][Bb][Aa][Nn]%s+(%S+)$")
    if target then
        deleteFirebaseData("bans/" .. target:lower())
        sendAriaAnnouncement("🔓 ARIA unbanned @" .. target)
        ariaReply("@" .. target .. " has been unbanned.")
        return true
    end

    ariaReply("Unknown command. Type /help aria for the ARIA command list.")
    return true
end

-- Send Message Function
local function sendMsg() 
    local txt = CInput.Text 
    if txt == "" then return end 
    CInput.Text = "" 

    local lowerTxt = txt:lower()

    if handleAriaCommand(txt, lowerTxt) then
        return
    end

    if lowerTxt == "/stopmusic" then
        if hasAdminAccess(PlayerName) or hasMusicAccess(PlayerName) then
            globalSound:Stop()
            addSys("🔇 Local music playback stopped.")
        else
            addSys("❌ You don't have permission to stop music!")
        end
        return
    end

    if lowerTxt == "/help" then
        addSys("📋 critical Server Commands:\n• /help - Show command list\n• /rule - Show server rules\n• /stopmusic - Stop audio\n• /w <user> <msg> - Private message (Ares-style DM)\n• @username - Tag a player\n• temprank <user> [title] - Director-only TempRank (default CRITICAL)\n• removetemprank <user> - Director-only\n• announce <msg> (Creator/Director)\n• ban <user> <reason> (Creator/Director)\n• unban <user> (Creator/Director)\n• setrank <user> <title> (Director Only)\n• removerank <user> (Director Only)\n• play <id> / play 0 (Director/Creator/Music Access)\n• volume <0-10> (Director/Creator/Music Access)\n• /help aria - Ask ARIA for ARIA commands and system status")
        return
    end

    if lowerTxt == "/rule" or lowerTxt == "/rules" then
        addSys("📜 Server Rules:\n1. Respect all players\n2. No exploiting or spamming\n3. Staff decisions are final")
        return
    end

    -- DIRECTOR-ONLY TEMP RANK MANAGEMENT. The default TempRank is [CRITICAL].
    if lowerTxt:sub(1, 9) == "temprank " or lowerTxt == "temprank" or lowerTxt:sub(1, 13) == "removetemprank " then
        if not isDirectorUser(PlayerName) then
            addSys("❌ TempRank is Director-only.")
            return
        end
        if lowerTxt == "temprank" then
            putFirebaseData("temp_ranks/" .. PlayerName:lower(), {title = "[CRITICAL]", assignedBy = PlayerName, timestamp = os.time()})
            syncRanks()
            addSys("✅ Your TempRank is now [CRITICAL].")
            return
        end
        if lowerTxt:sub(1, 13) == "removetemprank " then
            local target = txt:sub(14):match("%S+")
            if target then
                deleteFirebaseData("temp_ranks/" .. target:lower())
                deleteFirebaseData("dynamic_ranks/" .. target:lower())
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🗑️ Director removed TempRank from @" .. target, timestamp = os.time(), isSys = true})
                addSys("🗑️ TempRank removed from @" .. target)
            end
            return
        end
        local args = {}
        for word in txt:gmatch("%S+") do table.insert(args, word) end
        local target = args[2]
        local title = table.concat(args, " ", 3)
        if target then
            if title == "" then title = "CRITICAL" end
            title = "[" .. title:gsub("[%[%]]", ""):upper() .. "]"
            putFirebaseData("temp_ranks/" .. target:lower(), {title = title, assignedBy = PlayerName, timestamp = os.time()})
            putFirebaseData("dynamic_ranks/" .. target:lower(), {title = title, type = "rgb", removed = false, tempRank = true, assignedBy = PlayerName, timestamp = os.time()})
            syncRanks()
            sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "⚠️ Director assigned TempRank " .. title .. " to @" .. target, timestamp = os.time(), isSys = true})
            addSys("✅ TempRank " .. title .. " assigned to @" .. target)
        end
        return
    end

    -- DIRECTOR-ONLY PERMANENT RANK MANAGEMENT.
    -- Syntax: /permrank username tag name rainbow|rgb|any named color|#RRGGBB|R,G,B
    if lowerTxt:sub(1, 9) == "/permrank " or lowerTxt == "/permrank" then
        if not isDirectorUser(PlayerName) then
            addSys("❌ /permrank is Director-only.")
            return
        end
        local args = {}
        for word in txt:gmatch("%S+") do table.insert(args, word) end
        local target = args[2]
        if not target or #args < 4 then
            addSys("Usage: /permrank username tag name rainbow|rgb|any named color|#RRGGBB|R,G,B")
            return
        end
        local colorSpec = args[#args]
        local colorData = parseRankColor(colorSpec)
        if not colorData then
            addSys("❌ Invalid color. Use rainbow, a named color, #RRGGBB, or R,G,B.")
            return
        end
        local tagEnd = #args - 1
        local tagText = table.concat(args, " ", 3, tagEnd):gsub("[%[%]]", "")
        if tagText == "" then
            addSys("❌ Enter a custom tag name.")
            return
        end
        local record = {
            title = "[" .. tagText:upper() .. "]",
            assignedBy = PlayerName,
            timestamp = os.time(),
            permanent = true,
        }
        for key, value in pairs(colorData) do record[key] = value end
        putFirebaseData("permanent_ranks/" .. target:lower(), record)
        -- Mirror into dynamic_ranks so older clients also render the rank immediately.
        putFirebaseData("dynamic_ranks/" .. target:lower(), record)
        syncRanks()
        sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🏷️ Director assigned permanent rank " .. record.title .. " to @" .. target, timestamp = os.time(), isSys = true})
        addSys("✅ Permanent rank " .. record.title .. " assigned to @" .. target)
        return
    end

    -- DIRECTOR-ONLY RANK MANAGEMENT
    if isDirectorUser(PlayerName) then
        if lowerTxt:sub(1, 9) == "setrank " then
            local args = {} for w in txt:gmatch("%S+") do table.insert(args, w) end
            local targetUser = args[2]
            local rankTitle = table.concat(args, " ", 3)
            if targetUser and rankTitle ~= "" then
                putFirebaseData("dynamic_ranks/" .. targetUser:lower(), {title = "[" .. rankTitle:upper() .. "]", type = "rgb", removed = false})
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "⭐ Director assigned rank [" .. rankTitle:upper() .. "] to @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("✅ Rank [" .. rankTitle:upper() .. "] assigned to " .. targetUser)
            end
            return
        elseif lowerTxt:sub(1, 12) == "removerank " then
            local targetUser = txt:sub(13):match("%S+")
            if targetUser then
                putFirebaseData("dynamic_ranks/" .. targetUser:lower(), {title = "NONE", removed = true})
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🗑️ Director removed rank from @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🗑️ Rank removed from " .. targetUser)
            end
            return
        end
    end

    -- CREATOR & DIRECTOR ADMIN COMMANDS
    if hasAdminAccess(PlayerName) then
        if lowerTxt:sub(1, 9) == "announce " then
            sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "📢 [ANNOUNCEMENT] " .. txt:sub(10), timestamp = os.time(), isSys = true})
            addSys("📢 Announcement sent!")
            return
        elseif lowerTxt:sub(1, 6) == "unban " then
            local targetUser = txt:sub(7):match("%S+")
            if targetUser then
                deleteFirebaseData("bans/" .. targetUser:lower())
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔓 Staff UNBANNED @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🔓 " .. targetUser .. " has been unbanned")
            end
            return
        elseif lowerTxt:sub(1, 4) == "ban " then
            local args = {} for w in txt:gmatch("%S+") do table.insert(args, w) end
            local targetUser = args[2]
            local reason = table.concat(args, " ", 3)
            if targetUser then
                if isDirectorUser(targetUser) then
                    addSys("🛡️ Action blocked: Director ranks are immune to bans!")
                    return
                end
                putFirebaseData("bans/" .. targetUser:lower(), {banned = true, reason = reason ~= "" and reason or "Banned by Staff", by = PlayerName, timestamp = os.time()})
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔨 Staff PERMANENTLY BANNED @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🔨 " .. targetUser .. " has been banned")
            end
            return
        end
    end

    -- VOLUME COMMAND - Updated to allow APEX_SHADOW728
    if lowerTxt:sub(1, 7) == "volume " or lowerTxt:sub(1, 4) == "vol " then
        local volNum = tonumber(txt:match("%d+"))
        if volNum then
            volNum = math.clamp(volNum, 0, 10)
            if hasAdminAccess(PlayerName) or hasMusicAccess(PlayerName) then
                putFirebaseData("servers/" .. SERVER_KEY .. "/global_volume", {volume = volNum, setBy = PlayerName})
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔊 Server Volume set to " .. volNum, timestamp = os.time(), isSys = true})
                addSys("🔊 Volume set to " .. volNum)
            else
                addSys("❌ You don't have permission to change volume! (Volume permission: approved music users, Directors, Creators)")
            end
        end
        return
    end

    -- MUSIC COMMAND - Updated to allow APEX_SHADOW728
    if lowerTxt:sub(1, 5) == "play " or lowerTxt:sub(1, 6) == "music " then
        local assetId = txt:match("%d+")
        if assetId then
            if hasAdminAccess(PlayerName) or hasMusicAccess(PlayerName) then
                putFirebaseData("servers/" .. SERVER_KEY .. "/global_music", {audioId = assetId, playedBy = PlayerName, timestamp = os.time()})
                if assetId == "0" then
                    sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔇 Server Music STOPPED", timestamp = os.time(), isSys = true})
                    addSys("🔇 Music stopped")
                else
                    sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🎵 Playing Audio ID: " .. assetId, timestamp = os.time(), isSys = true})
                    addSys("🎵 Playing music ID: " .. assetId)
                end
            else
                addSys("❌ You don't have permission to play music! (Music permission: approved music users, Directors, Creators)")
            end
        end
        return
    end

    -- Private Messages: route /w and /pm through the stable DM function.
    if lowerTxt:sub(1, 3) == "/w " or lowerTxt:sub(1, 4) == "/pm " then
        local args = {}
        for word in txt:gmatch("%S+") do table.insert(args, word) end
        local targetName = args[2]
        local pvtMessage = table.concat(args, " ", 3)
        local foundTarget = nil
        if targetName then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == targetName:lower() or p.DisplayName:lower() == targetName:lower() then
                    foundTarget = p
                    break
                end
            end
        end
        if foundTarget and pvtMessage ~= "" then
            currentDMTarget = foundTarget
            DmHeader.Text = " 🔒 Private chat with @" .. foundTarget.Name
            DmInput.Text = pvtMessage
            sendDM()
            switchTab("DMS")
        elseif not foundTarget then
            addSys("❌ Player '" .. tostring(targetName or "") .. "' not found in server.")
        end
        return
    end

    -- Edit an existing message in-place, or send a new message with reply/tag metadata.
    if editingMessage then
        local editedAt = os.time()
        updateMessageInFirebase(editingMessage.root, editingMessage.id, {Text = txt, edited = true, editedAt = editedAt, mentions = getMentionNames(txt)})
        if messageTextLabels[editingMessage.id] and messageTextLabels[editingMessage.id].label then
            local meta = messageTextLabels[editingMessage.id]
            local rankInfo = meta.rankInfo
            if rankInfo and rankInfo.type ~= "rgb" then
                local hex = string.format("#%02X%02X%02X", math.floor(rankInfo.color.R * 255), math.floor(rankInfo.color.G * 255), math.floor(rankInfo.color.B * 255))
                meta.label.Text = string.format("<font color=\"%s\"><b>%s</b></font> <b>%s:</b> %s", hex, rankInfo.title, escapeRichText(meta.dispName), formatMentions(txt))
            else
                meta.label.Text = string.format("<b>%s:</b> %s", escapeRichText(meta.dispName), formatMentions(txt))
            end
        end
        editingMessage = nil
        sendBigWhiteNotification("✅ Message edited")
        return
    end

    local currentReply = replyingToMsg
    replyingToMsg = nil
    ReplyPreviewFrame.Visible = false
    MsgScroll.Size = UDim2.new(1, -6, 1, -48)
    local msgId = makeMessageId("msg")
    addMsg(PlayerName, DisplayName, txt, MsgScroll, false, nil, UserId, msgId, currentReply)
    renderedMessageIds[msgId] = true
    processedMessages[msgId] = true
    putFirebaseData("servers/" .. SERVER_KEY .. "/messages/" .. msgId, {
        Sender = PlayerName, DisplayName = DisplayName, UserId = UserId,
        Text = txt, mentions = getMentionNames(txt), replyData = currentReply,
        isPrivate = false, timestamp = os.time()
    })
end 

