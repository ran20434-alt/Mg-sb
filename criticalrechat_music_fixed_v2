local function sendDM()
    if not currentDMTarget then
        sendBigWhiteNotification("⚠️ Please select a user to DM first!")
        return
    end
    local txt = DmInput.Text
    if txt == "" then return end
    DmInput.Text = ""
    if editingMessage then
        updateMessageInFirebase(editingMessage.root, editingMessage.id, {Text = txt, edited = true, editedAt = os.time(), mentions = getMentionNames(txt)})
        if messageTextLabels[editingMessage.id] and messageTextLabels[editingMessage.id].label then
            local meta = messageTextLabels[editingMessage.id]
            meta.label.Text = string.format("<b>%s:</b> %s", escapeRichText(meta.dispName), formatMentions(txt))
        end
        editingMessage = nil
        sendBigWhiteNotification("✅ DM edited")
        return
    end
    local dmKey = getDMChannelKey(UserId, currentDMTarget.UserId)
    local msgId = makeMessageId("dm")
    local payload = {
        Sender = PlayerName, DisplayName = DisplayName, UserId = UserId,
        TargetUserId = currentDMTarget.UserId, TargetName = currentDMTarget.Name,
        Text = txt, mentions = getMentionNames(txt), replyData = replyingToDMMsg, timestamp = os.time()
    }
    putFirebaseData("dm_channels/" .. dmKey .. "/" .. msgId, payload)
    addMsg(PlayerName, DisplayName, txt, DmMsgScroll, false, nil, UserId, msgId, replyingToDMMsg, true)
    replyingToDMMsg = nil
    DmInput.PlaceholderText = "Private message..."
end

