local function parseRankColor(value)
    local raw = tostring(value or ""):lower():gsub("%s+", "")
    if raw == "rainbow" or raw == "rgb" then
        return {type = "rgb"}
    end
    local namedColors = {
        red = {r = 255, g = 0, b = 0},
        green = {r = 0, g = 255, b = 0},
        blue = {r = 0, g = 120, b = 255},
        yellow = {r = 255, g = 215, b = 0},
        purple = {r = 180, g = 0, b = 255},
        pink = {r = 255, g = 40, b = 180},
        white = {r = 255, g = 255, b = 255},
        black = {r = 0, g = 0, b = 0},
        orange = {r = 255, g = 128, b = 0},
        cyan = {r = 0, g = 255, b = 255},
        aqua = {r = 0, g = 255, b = 255},
        magenta = {r = 255, g = 0, b = 255},
        fuchsia = {r = 255, g = 0, b = 255},
        lime = {r = 50, g = 205, b = 50},
        navy = {r = 0, g = 0, b = 128},
        teal = {r = 0, g = 128, b = 128},
        olive = {r = 128, g = 128, b = 0},
        maroon = {r = 128, g = 0, b = 0},
        silver = {r = 192, g = 192, b = 192},
        gray = {r = 128, g = 128, b = 128},
        grey = {r = 128, g = 128, b = 128},
        brown = {r = 165, g = 42, b = 42},
        gold = {r = 255, g = 215, b = 0},
        violet = {r = 238, g = 130, b = 238},
        indigo = {r = 75, g = 0, b = 130},
        turquoise = {r = 64, g = 224, b = 208},
        coral = {r = 255, g = 127, b = 80},
        crimson = {r = 220, g = 20, b = 60},
        salmon = {r = 250, g = 128, b = 114},
        beige = {r = 245, g = 245, b = 220},
        transparent = {r = 255, g = 255, b = 255},
    }
    if namedColors[raw] then
        return namedColors[raw]
    end
    local hex = raw:match("^#?(%x%x)(%x%x)(%x%x)$")
    if hex then
        return {r = tonumber(hex:sub(1, 2), 16), g = tonumber(hex:sub(3, 4), 16), b = tonumber(hex:sub(5, 6), 16)}
    end
    local r, g, b = raw:match("^(%d+),(%d+),(%d+)$")
    if r and g and b then
        return {r = math.clamp(tonumber(r), 0, 255), g = math.clamp(tonumber(g), 0, 255), b = math.clamp(tonumber(b), 0, 255)}
    end
    return nil
end

