-- Load Dynamic Ranks
local function syncRanks()
    local ranksData = getFirebaseData("dynamic_ranks") or {}
    local permanentRanks = getFirebaseData("permanent_ranks") or {}
    local tempRanks = getFirebaseData("temp_ranks") or {}
    DYNAMIC_RANKS = {}
    for user, rData in pairs(ranksData) do
        if type(rData) == "table" then
            if rData.title == "NONE" or rData.removed == true then
                DYNAMIC_RANKS[user:lower()] = false
            elseif rData.type == "rgb" then
                DYNAMIC_RANKS[user:lower()] = {title = rData.title, type = "rgb"}
            elseif rData.r and rData.g and rData.b then
                DYNAMIC_RANKS[user:lower()] = {title = rData.title, color = Color3.fromRGB(rData.r, rData.g, rData.b)}
            else
                DYNAMIC_RANKS[user:lower()] = {title = rData.title, color = Color3.fromRGB(255, 215, 0)}
            end
        end
    end
    for user, rData in pairs(permanentRanks) do
        if type(rData) == "table" and rData.title then
            if rData.type == "rgb" then
                DYNAMIC_RANKS[user:lower()] = {title = rData.title, type = "rgb", permanentRank = true}
            elseif rData.r and rData.g and rData.b then
                DYNAMIC_RANKS[user:lower()] = {title = rData.title, color = Color3.fromRGB(rData.r, rData.g, rData.b), permanentRank = true}
            end
        end
    end
    for user, rData in pairs(tempRanks) do
        if type(rData) == "table" and rData.title then
            DYNAMIC_RANKS[user:lower()] = {title = rData.title, type = "rgb", tempRank = true}
        end
    end
end
