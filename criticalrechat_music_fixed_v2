local function openHoldMenu(msgId, sender, dispName, text, bubFrame)
    if not msgId then return end
    
    ContextMenu.Visible = false
    for _, child in ipairs(ContextMenu:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local isOwn = (sender == PlayerName)
    local isDM = currentDMTarget ~= nil and bubFrame:IsDescendantOf(DmMsgScroll)
    local dataRoot = isDM and ("dm_channels/" .. getDMChannelKey(UserId, currentDMTarget.UserId)) or ("servers/" .. SERVER_KEY .. "/messages")
    local posY = math.clamp(bubFrame.AbsolutePosition.Y - SrvPage.AbsolutePosition.Y + 20, 10, SrvPage.AbsoluteSize.Y - 180)
    local posX = math.clamp(bubFrame.AbsolutePosition.X - SrvPage.AbsolutePosition.X + 36, 10, SrvPage.AbsoluteSize.X - 200)

    ContextMenu.Position = UDim2.new(0, posX, 0, posY)

    if isOwn then
        createContextMenuBtn("✏️ Edit Message", function()
            editingMessage = {id = msgId, text = text, root = dataRoot}
            if isDM then
                DmInput.Text = text
                DmInput:CaptureFocus()
            else
                CInput.Text = text
                CInput:CaptureFocus()
            end
            sendBigWhiteNotification("✏️ Editing message — send to save changes")
        end)
        createContextMenuBtn("📋 Copy Message", function()
            CopyToClipboard(text)
            sendBigWhiteNotification("📋 Copied text to clipboard!")
        end)
        createContextMenuBtn("↪️ Reply", function()
            local reply = {sender = dispName or sender, text = text}
            if isDM then
                replyingToDMMsg = reply
                DmInput.PlaceholderText = "Replying to @" .. (dispName or sender) .. " — type message..."
                sendBigWhiteNotification("↪️ Replying privately to your message")
            else
                replyingToMsg = reply
                ReplyPreviewText.Text = "↪️ Replying to your message: " .. text
                ReplyPreviewFrame.Visible = true
                MsgScroll.Size = UDim2.new(1, -6, 1, -72)
                sendBigWhiteNotification("↪️ Replying to your message")
            end
            ContextMenu.Visible = false
        end)
        createContextMenuBtn("🗑️ Delete Message", function()
            deleteFirebaseData(dataRoot .. "/" .. msgId)
            sendBigWhiteNotification("🗑️ Message deleted!")
            if messageFrames[msgId] then
                messageFrames[msgId]:Destroy()
                messageFrames[msgId] = nil
                renderedMessageIds[msgId] = nil
            end
        end)
    else
        createContextMenuBtn("🔒 Private Chat", function()
            local targetPlr = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == sender:lower() then targetPlr = p break end
            end
            if targetPlr then
                currentDMTarget = targetPlr
                DmHeader.Text = " 🔒 Chatting with @" .. targetPlr.Name
                switchTab("DMS")
                loadDMHistoryForTarget(targetPlr)
                sendBigWhiteNotification("💬 Opened DM with " .. targetPlr.Name)
            else
                sendBigWhiteNotification("⚠️ Target player is not in server!")
            end
        end)
        createContextMenuBtn("📋 Copy Message", function()
            CopyToClipboard(text)
            sendBigWhiteNotification("📋 Copied text to clipboard!")
        end)
        createContextMenuBtn("💬 Reply", function()
            replyingToMsg = {sender = dispName or sender, text = text}
            ReplyPreviewText.Text = "💬 Replying to @" .. (dispName or sender) .. ": " .. text
            ReplyPreviewFrame.Visible = true
            MsgScroll.Size = UDim2.new(1, -6, 1, -72)
            sendBigWhiteNotification("💬 Replying to " .. (dispName or sender))
            ContextMenu.Visible = false
        end)
    end

    ContextMenu.Visible = true
end

