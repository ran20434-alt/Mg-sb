end
local function publishSoundCloudTrack(track, reportStatus)
    task.spawn(function()
        local streamUrl, err = scResolve(track)
        if not streamUrl then
            local message = "Could not play this result: " .. tostring(err)
            warn("[critical ReChAt Music] " .. message)
            if reportStatus then reportStatus(message) end
            return
        end
        local eventId = tostring(os.time()) .. "_" .. tostring(math.random(100000,999999))
        local title = tostring(track.title or "SoundCloud track"):sub(1, 160)
        local role = isDirectorUser(PlayerName) and "Director" or "music user"
        putFirebaseData("servers/" .. SERVER_KEY .. "/global_music", {
            action="play", provider="soundcloud", eventId=eventId, streamUrl=streamUrl,
            title=title, playedBy=PlayerName, playedByRole=role,
            duration=math.floor((tonumber(track.duration) or 0)/1000), timestamp=os.time()
        })
        scLastEventId = eventId
        lastPlayedMusicId = "sc:" .. eventId
        local played, playErr = playLocalStream(streamUrl, eventId)
        local notice = "🎵 “" .. title .. "” is being played by " .. role .. " @" .. PlayerName
        sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {
            Sender="SYSTEM", DisplayName="MUSIC", Text=notice,
            timestamp=os.time(), isSys=true, musicEventId=eventId
        })
        if not played then
            warn("[critical ReChAt Music] " .. tostring(playErr))
            if reportStatus then reportStatus("Broadcast sent; local playback failed: " .. tostring(playErr)) end
        elseif reportStatus then
            reportStatus("Now playing: “" .. title .. "” · started by " .. role .. " @" .. PlayerName)
