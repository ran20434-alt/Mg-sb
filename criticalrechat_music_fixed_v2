local function escapeRichText(value)
    value = tostring(value or "")
    value = value:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    return value
end

local function findMentionPlayer(token)
    local wanted = tostring(token or ""):lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == wanted or plr.DisplayName:lower() == wanted then
            return plr
        end
    end
    return nil
end

local function formatMentions(value)
    local escaped = escapeRichText(value)
    return escaped:gsub(mentionPattern, function(token)
        if token:lower() == "everyone" then
            return '<font color="#ffd050"><b>@everyone</b></font>'
        end
        local target = findMentionPlayer(token)
        local shown = target and target.DisplayName or token
        return '<font color="#ff4fd8"><b>@' .. escapeRichText(shown) .. '</b></font>'
    end)
end

local function messageMentionsLocalPlayer(value)
    local lower = tostring(value or ""):lower()
    if lower:find("@everyone", 1, true) then return true end
    return lower:find("@" .. PlayerName:lower(), 1, true) ~= nil
        or lower:find("@" .. DisplayName:lower(), 1, true) ~= nil
end

local function getMentionNames(value)
    local result = {}
    for name in tostring(value or ""):gmatch(mentionPattern) do
        table.insert(result, name)
    end
    return result
end

