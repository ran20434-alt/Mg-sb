                local thumb = Players:GetUserThumbnailAsync(targetUserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                if thumb and pAvatarFrame then pAvatarFrame.Image = thumb end
            end)
