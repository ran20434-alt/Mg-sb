local function runMusicSearch()
    if not musicAllowed() then MusicStatus.Text="Music access denied."; return end
    local query=MusicSearch.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if query=="" then MusicStatus.Text="Enter a search term."; return end
    scCurrentRequest += 1
    local requestId=scCurrentRequest
    MusicSearchBtn.Text="..."
    MusicStatus.Text="Searching SoundCloud..."
    clearMusicResults()
    task.spawn(function()
        local tracks, err=scSearch(query)
        if requestId~=scCurrentRequest then return end
        MusicSearchBtn.Text="Search"
        if not tracks then
            MusicStatus.Text="Search failed: " .. tostring(err) .. " (check HTTP access / SoundCloud availability)"
            return
        end
        local shown=0
        for _, track in ipairs(tracks) do
            -- Show every track result; stream metadata is checked only when a row is selected.
            if track.kind=="track" then
                shown += 1
                local duration=math.floor((tonumber(track.duration) or 0)/1000)
                local button=Instance.new("TextButton")
                button.Name="Track_" .. tostring(shown)
                button.Size=UDim2.new(1,-4,0,40)
                button.LayoutOrder=shown
                button.BackgroundColor3=C.BG3
                button.Text=string.format("▶  %s  ·  %d:%02d", tostring(track.title or "Untitled"):sub(1,95), math.floor(duration/60), duration%60)
                button.TextColor3=C.WHITE
                button.TextSize=10
                button.Font=Enum.Font.Gotham
                button.TextXAlignment=Enum.TextXAlignment.Left
                button.TextTruncate=Enum.TextTruncate.AtEnd
                button.ZIndex=503
                button.Parent=MusicResults
                corner(button,5)
                button.Activated:Connect(function()
                    if not musicAllowed() then return end
                    MusicStatus.Text="Resolving and broadcasting: " .. tostring(track.title or "track")
                    publishSoundCloudTrack(track, function(message)
                        if MusicStatus and MusicStatus.Parent then MusicStatus.Text=message end
                    end)
                end)
            end
        end
        MusicStatus.Text=shown>0 and (tostring(shown) .. " tracks · tap a row to broadcast") or "No playable progressive tracks found."
    end)
end
MusicSearchBtn.Activated:Connect(runMusicSearch)
