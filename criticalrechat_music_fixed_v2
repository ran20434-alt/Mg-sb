        bub.Size=UDim2.new(0.85, 0, 0, 0)
        bub.Position=UDim2.new(0, 36, 0, 0)
        bub.AutomaticSize=Enum.AutomaticSize.Y
        bub.BackgroundColor3 = isPrivate and Color3.fromRGB(60, 20, 80) or C.THEM
        bub.ZIndex=504
        bub.Parent=msgContentFrame
        corner(bub,8) 

        local lbl=Instance.new("TextButton")
        lbl.Size=UDim2.new(1,-32,0,0)
        lbl.AutomaticSize=Enum.AutomaticSize.Y
        lbl.Position=UDim2.new(0,6,0,5)
        lbl.BackgroundTransparency=1
        lbl.RichText=true
        lbl.TextColor3=C.WHITE
        lbl.TextSize=12
        lbl.Font=Enum.Font.Gotham
        lbl.TextWrapped=true
        lbl.TextXAlignment=Enum.TextXAlignment.Left
        lbl.ZIndex=505
        lbl.Parent=bub

        if rankInfo then
            if rankInfo.type == "rgb" then
                RgbLabels[lbl] = {rankTitle = rankInfo.title, dispName = dispName or sender, msgText = text, isImg = false}
            else
                local hex = string.format("#%02X%02X%02X", math.floor(rankInfo.color.R * 255), math.floor(rankInfo.color.G * 255), math.floor(rankInfo.color.B * 255))
                lbl.Text = string.format("<font color=\"%s\"><b>%s</b></font> <b>%s:</b> %s", hex, rankInfo.title, escapeRichText(dispName or sender), formatMentions(text))
            end
        else
            lbl.Text = string.format("<b>%s:</b> %s", escapeRichText(dispName or sender), formatMentions(text))
        end

        if msgId then
            messageTextLabels[msgId] = {label = lbl, sender = sender, dispName = dispName or sender, rankInfo = rankInfo}
        end

        -- Long press handler for context menu
        local holding = false
        local holdToken = 0
        local holdStarted = false

        local function startHold()
            if holdStarted then return end
            holdStarted = true
            holding = true
            holdToken += 1
            local myToken = holdToken
            task.delay(HOLD_TIME, function()
                if holding and myToken == holdToken and msgId then
                    openHoldMenu(msgId, sender, dispName or sender, text, bub)
                end
                holdStarted = false
            end)
        end

        local function endHold()
            holding = false
            holdStarted = false
            holdToken += 1
        end

        lbl.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                startHold()
            end
        end)

        lbl.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                endHold()
            end
        end)

        bub.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                startHold()
            end
        end)

        bub.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                endHold()
            end
        end)

        -- Double-tap another player's message to open a private chat.
        local lastTapAt = 0
        local tapStartedAt = 0
        local function handleDoubleTap(input)
            if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            local now = os.clock()
            local tapDuration = now - tapStartedAt
            if tapDuration > 0.45 then return end
            if now - lastTapAt <= 0.35 then
                local targetPlr = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Name:lower() == tostring(sender):lower() or p.DisplayName:lower() == tostring(sender):lower() then
                        targetPlr = p
                        break
                    end
                end
                if targetPlr and targetPlr ~= Player then
                    currentDMTarget = targetPlr
                    DmHeader.Text = " 🔒 Private chat with @" .. targetPlr.Name
                    switchTab("DMS")
                    loadDMHistoryForTarget(targetPlr)
                    sendBigWhiteNotification("💬 Private chat opened with " .. targetPlr.Name)
                end
                lastTapAt = 0
            else
                lastTapAt = now
            end
        end
        lbl.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                tapStartedAt = os.clock()
            end
        end)
        lbl.InputEnded:Connect(handleDoubleTap)
        bub.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                tapStartedAt = os.clock()
            end
        end)
        bub.InputEnded:Connect(handleDoubleTap)

        -- Swipe right on a message to reply to it.
        local swipeStart = nil
        local swipeStartAt = 0
        local function beginSwipe(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                swipeStart = Vector2.new(input.Position.X, input.Position.Y)
                swipeStartAt = os.clock()
            end
        end
        local function finishSwipe(input)
            if input.UserInputType ~= Enum.UserInputType.Touch or not swipeStart then return end
            local finish = Vector2.new(input.Position.X, input.Position.Y)
            local delta = finish - swipeStart
            swipeStart = nil
            if os.clock() - swipeStartAt <= 0.8 and delta.X >= 70 and math.abs(delta.Y) <= 60 then
                local reply = {sender = dispName or sender, text = text}
                if isPrivate then
                    replyingToDMMsg = reply
                    DmInput.PlaceholderText = "Replying to @" .. (dispName or sender) .. " — type message..."
                    sendBigWhiteNotification("↪️ Replying privately to @" .. (dispName or sender))
                else
                    replyingToMsg = reply
                    ReplyPreviewText.Text = "↪️ Replying to @" .. (dispName or sender) .. ": " .. text
                    ReplyPreviewFrame.Visible = true
                    MsgScroll.Size = UDim2.new(1, -6, 1, -72)
                    sendBigWhiteNotification("↪️ Replying to @" .. (dispName or sender))
                end
            end
        end
        lbl.InputBegan:Connect(beginSwipe)
        lbl.InputEnded:Connect(finishSwipe)
        bub.InputBegan:Connect(beginSwipe)
        bub.InputEnded:Connect(finishSwipe)

    end

    task.spawn(function() 
        if targetScroll then targetScroll.CanvasPosition=Vector2.new(0,targetScroll.AbsoluteCanvasSize.Y) end 
    end)
end 

