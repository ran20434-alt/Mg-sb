-- SoundCloud search and per-server broadcast. Audio is downloaded to a local
-- custom asset because Roblox Sound objects do not play arbitrary HTTPS URLs.
local SC_API = "https://api-v2.soundcloud.com"
-- Public fallback client ID carried by the supplied Ares script. The scraper
-- refreshes it after API rejection; this prevents a blocked homepage scrape
-- from disabling search before the first API request.
local scClientId = "tNiXK56A9yLDayzQ5DsBvqwiyhRLZZNv"
local scTrackCounter = 0
local scCurrentRequest = 0
local scLastEventId = ""
local function scHttp(url, method)
    if not httpRequest then return nil, "HTTP request API unavailable" end
    local ok, response = pcall(httpRequest, {Url=url, Method=method or "GET", Headers={ ["User-Agent"]="Mozilla/5.0", Accept="application/json" }})
    if not ok or not response then return nil, tostring(response or "empty HTTP response") end
    local code = tonumber(response.StatusCode)
    local succeeded = response.Success
    if succeeded == nil then succeeded = code ~= nil and code >= 200 and code < 300 end
    if not succeeded then return nil, "HTTP " .. tostring(code or "request failed") end
    if type(response.Body) ~= "string" or response.Body == "" then return nil, "empty response body" end
    return response.Body
end
local function getSoundCloudClientId(force)
    if scClientId and not force then return scClientId end
    local home = scHttp("https://soundcloud.com/")
    if not home then return scClientId end
    local scripts = {}
    for src in home:gmatch('<script[^>]-src=["\']([^"\']+)["\']') do
        if src:find("sndcdn", 1, true) or src:find("assets", 1, true) then
            if src:sub(1,2) == "//" then src = "https:" .. src end
            if src:sub(1,1) == "/" then src = "https://soundcloud.com" .. src end
            table.insert(scripts, src)
        end
    end
    for _, src in ipairs(scripts) do
        local js = scHttp(src)
        if js then
            local id = js:match('["\']client_id["\']%s*:%s*["\']([%w]+)["\']')
                or js:match('client_id%s*=%s*["\']([%w]+)["\']')
                or js:match('client_id=([%w]+)&')
            if id and #id >= 16 then scClientId = id; return id end
        end
    end
    return scClientId
end
local function scSearch(query)
    local id = getSoundCloudClientId(false) or getSoundCloudClientId(true)
    if not id then return nil, "SoundCloud client ID could not be refreshed" end
    local url = SC_API .. "/search/tracks?q=" .. HttpService:UrlEncode(query) .. "&client_id=" .. id .. "&limit=25&offset=0"
    local body, err = scHttp(url)
    if not body then
        id = getSoundCloudClientId(true)
        if not id then return nil, err end
        body, err = scHttp(SC_API .. "/search/tracks?q=" .. HttpService:UrlEncode(query) .. "&client_id=" .. id .. "&limit=25&offset=0")
    end
    if not body then return nil, err end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(data) ~= "table" or type(data.collection) ~= "table" then return nil, "Invalid SoundCloud search response" end
    return data.collection
end
local function scResolve(track)
    if type(track) ~= "table" or type(track.media) ~= "table" or type(track.media.transcodings) ~= "table" then
        return nil, "Track has no stream metadata"
    end
    local id = getSoundCloudClientId(false) or getSoundCloudClientId(true)
    if not id then return nil, "SoundCloud client ID unavailable" end
    local transcode
    for _, item in ipairs(track.media.transcodings) do
        if item.format and item.format.protocol == "progressive" and type(item.url) == "string" then
            transcode = item.url
            break
        end
    end
    if not transcode then return nil, "Track has no progressive stream" end
    local sep = transcode:find("?", 1, true) and "&" or "?"
    local body, err = scHttp(transcode .. sep .. "client_id=" .. id)
    if not body then return nil, err end
    local ok, stream = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(stream) ~= "table" or type(stream.url) ~= "string" then return nil, "SoundCloud did not return a stream URL" end
    return stream.url
end
local function playLocalStream(streamUrl, eventId)
    if type(streamUrl) ~= "string" or streamUrl == "" then return false, "Missing stream URL" end
    if not (writefile and getcustomasset) then return false, "This client needs writefile/getcustomasset support to play streamed audio" end
    local ok, response = pcall(httpRequest, {Url=streamUrl, Method="GET", Headers={ ["User-Agent"]="Mozilla/5.0" }})
    local code = response and tonumber(response.StatusCode)
    local succeeded = response and response.Success
    if succeeded == nil then succeeded = code ~= nil and code >= 200 and code < 300 end
    if not ok or not response or not succeeded or type(response.Body) ~= "string" or #response.Body == 0 then
        return false, "Audio stream download failed"
    end
    scTrackCounter += 1
    local safeId = tostring(eventId or os.time()):gsub("[^%w_-]", "")
    local path = "critical_music/track_" .. safeId .. "_" .. tostring(scTrackCounter) .. ".mp3"
    pcall(makefolder, "critical_music")
    local wrote = pcall(writefile, path, response.Body)
    if not wrote then return false, "Could not cache the stream" end
    local assetOk, asset = pcall(getcustomasset, path)
    if not assetOk or type(asset) ~= "string" or asset == "" then return false, "Could not load the cached audio asset" end
    globalSound:Stop()
    globalSound.Looped = false
    globalSound.SoundId = asset
    globalSound.TimePosition = 0
    globalSound:Play()
    local deadline = os.clock() + 10
    while os.clock() < deadline and not globalSound.IsLoaded and not globalSound.IsPlaying do task.wait(0.1) end
    if not globalSound.IsLoaded and not globalSound.IsPlaying then
        globalSound:Stop()
        return false, "Cached audio did not load"
    end
    return true
end
